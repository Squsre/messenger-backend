# Copy this file to `.env` and adjust the values for your environment.
# Never commit the real `.env` file to version control.

# --- Application ---
APP_NAME=Messenger API
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0

# --- API ---
API_V1_PREFIX=/api/v1
# Base URL used when composing links that are emailed to users. Point it at the
# front-end that serves /verify-email and /reset-password.
PUBLIC_BASE_URL=http://localhost:8000

# --- Server ---
HOST=127.0.0.1
PORT=8000

# --- CORS ---
# Comma-separated list of allowed origins, e.g. http://localhost:3000,https://app.example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Database ---
# SQLAlchemy URL. SQLite by default (relative to the project root).
# PostgreSQL later: postgresql+psycopg://user:password@localhost:5432/messenger
DATABASE_URL=sqlite:///./messenger.db
# Log every SQL statement (useful while debugging, keep false otherwise).
DB_ECHO=false

# --- Authentication / JWT ---
# REQUIRED. Secret used to sign access tokens. Generate a strong, unique value:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# The placeholder below is a throw-away for local development only and is
# refused when APP_ENV is not a local environment.
JWT_SECRET_KEY=dev-only-change-me-please-0123456789abcdefghijklmnopqrstuvwxyz
# HMAC algorithm; only HS256/HS384/HS512 are accepted.
JWT_ALGORITHM=HS256
# Access token lifetime in minutes (keep short).
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Token issuer/audience claims.
JWT_ISSUER=messenger-api
JWT_AUDIENCE=messenger-api

# --- Login rate limiting (in-process; see README) ---
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# --- Profiles and search ---
# How often an authenticated request may refresh `last_seen_at` (seconds).
LAST_SEEN_UPDATE_INTERVAL_SECONDS=60
# Record the client IP on a device session. It is only ever shown back to the
# account owner; turn this off where storing it is not permitted.
SESSION_STORE_IP=true
# Shortest accepted search term. Anything shorter is refused so usernames cannot
# be enumerated with one-character prefixes.
SEARCH_MIN_QUERY_LENGTH=2
SEARCH_DEFAULT_LIMIT=20
# Hard ceiling for one page, regardless of what a client asks for.
SEARCH_MAX_LIMIT=50

# --- Chat (one-to-one conversations) ---
# Hard ceiling for one page of conversations / messages, regardless of what a
# client asks for. The message body limit itself is a code-level policy
# (MESSAGE_MAX_LENGTH in app/core/security.py, mirrored by a CHECK constraint).
CONVERSATION_MAX_LIMIT=50
MESSAGE_MAX_LIMIT=100

# --- Email delivery ---
# console  : development only — renders the message to EMAIL_OUTBOX_DIR instead
#            of sending it. Refused unless APP_ENV is local/development/test.
# smtp     : real delivery over SMTP.
# disabled : drop messages (useful for tests and for switching email off).
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@messenger.local
EMAIL_OUTBOX_DIR=var/outbox
# Lifetime of the single-use links (minutes).
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# SMTP settings (only read when EMAIL_BACKEND=smtp).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# --- Account-security rate limits (per scope, in-process) ---
EMAIL_RATE_LIMIT_ATTEMPTS=3
EMAIL_RATE_LIMIT_WINDOW_SECONDS=3600
PASSWORD_RESET_RATE_LIMIT_ATTEMPTS=5
PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=3600
SEARCH_RATE_LIMIT_ATTEMPTS=60
SEARCH_RATE_LIMIT_WINDOW_SECONDS=60
CONTACT_RATE_LIMIT_ATTEMPTS=30
CONTACT_RATE_LIMIT_WINDOW_SECONDS=60
CHAT_RATE_LIMIT_ATTEMPTS=120
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
