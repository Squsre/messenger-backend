# Copy this file to `.env` and adjust the values for your environment.
# Never commit the real `.env` file to version control.

# --- Application ---
APP_NAME=Messenger API
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0

# --- API ---
API_V1_PREFIX=/api/v1
# Base URL used when composing links that are emailed to users. Point it at the
# front-end that serves /verify-email and /reset-password.
PUBLIC_BASE_URL=http://localhost:8000

# --- Server ---
HOST=127.0.0.1
PORT=8000
# Host port published by Compose for the API.
BACKEND_PORT=8000
# Keep one worker while the WebSocket registry is in-process (see README).
UVICORN_WORKERS=1

# --- CORS ---
# Comma-separated list of allowed origins, e.g. http://localhost:3000,https://app.example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Database (PostgreSQL only) ---
# PostgreSQL is the only supported database. The POSTGRES_* values below are
# read by compose.yaml; DATABASE_URL must use the same database, user, password
# and host port. Use a real secret only in your Git-ignored .env, never here.
POSTGRES_DB=messenger
POSTGRES_USER=messenger
POSTGRES_PASSWORD=dev-only-change-me
POSTGRES_PORT=5432
# These values initialize a new Docker volume. Changing them after the first
# startup does not update the existing role/database; update PostgreSQL
# manually (after a backup) or use a new volume deliberately.
# SQLAlchemy URL for the PostgreSQL driver in requirements.txt. URL-encode
# special characters in the password if you change it.
DATABASE_URL=postgresql+psycopg://messenger:dev-only-change-me@127.0.0.1:5432/messenger
# The test suite creates short-lived schemas in this separate database. It is
# created automatically if it does not exist; never point it at DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://messenger:dev-only-change-me@127.0.0.1:5432/messenger_test
# Log every SQL statement (useful while debugging, keep false otherwise).
DB_ECHO=false

# --- Redis (cache, shared rate limiting and ephemeral data) ---
# PostgreSQL remains the source of truth. Redis only holds disposable state.
# The password below initializes the local Compose service. Use a real secret
# only in your Git-ignored .env, never here. URL-encode special characters.
REDIS_PASSWORD=dev-only-change-me
REDIS_PORT=6379
REDIS_URL=redis://:dev-only-change-me@127.0.0.1:6379/0
# The test suite uses a separate Redis database and a unique key prefix per test.
# It never flushes the development database.
TEST_REDIS_URL=redis://:dev-only-change-me@127.0.0.1:6379/15
# Connection and command timeouts (seconds). Keep these short: Redis is an
# optional dependency for the cache and a fail-closed dependency for throttling.
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=1
REDIS_SOCKET_TIMEOUT_SECONDS=1
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
# Namespace for every key created by this application.
REDIS_KEY_PREFIX=messenger
# Cache public profiles for a short period. Restricted/private profiles and
# hidden last-seen values are never cached.
CACHE_ENABLED=true
PROFILE_CACHE_TTL_SECONDS=60
# closed = return 503 when Redis cannot enforce a rate limit (safer);
# open   = allow the request when Redis is unavailable.
RATE_LIMIT_FAILURE_POLICY=closed

# --- Authentication / JWT ---
# REQUIRED. Secret used to sign access tokens. Generate a strong, unique value:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# The placeholder below is a throw-away for local development only and is
# refused when APP_ENV is not a local environment.
JWT_SECRET_KEY=dev-only-change-me-please-0123456789abcdefghijklmnopqrstuvwxyz
# HMAC algorithm; only HS256/HS384/HS512 are accepted.
JWT_ALGORITHM=HS256
# Access token lifetime in minutes (keep short).
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Token issuer/audience claims.
JWT_ISSUER=messenger-api
JWT_AUDIENCE=messenger-api

# --- Shared rate limiting (Redis-backed; see README) ---
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# --- Profiles and search ---
# How often an authenticated request may refresh `last_seen_at` (seconds).
LAST_SEEN_UPDATE_INTERVAL_SECONDS=60
# Record the client IP on a device session. It is only ever shown back to the
# account owner; turn this off where storing it is not permitted.
SESSION_STORE_IP=true
# Shortest accepted search term. Anything shorter is refused so usernames cannot
# be enumerated with one-character prefixes.
SEARCH_MIN_QUERY_LENGTH=2
SEARCH_DEFAULT_LIMIT=20
# Hard ceiling for one page, regardless of what a client asks for.
SEARCH_MAX_LIMIT=50

# --- Chat (one-to-one conversations) ---
# Hard ceiling for one page of conversations / messages, regardless of what a
# client asks for. The message body limit itself is a code-level policy
# (MESSAGE_MAX_LENGTH in app/core/security.py, mirrored by a CHECK constraint).
CONVERSATION_MAX_LIMIT=50
MESSAGE_MAX_LIMIT=100

# --- Media (uploaded photos and files) ---
# Storage backend: "minio" for the Compose stack, "local" for development/tests.
# The local path must be outside the application package and is ignored by Git
# when the default var/media is used.
MEDIA_STORAGE_BACKEND=minio
MEDIA_STORAGE_PATH=var/media
# Per-file limit (bytes) and maximum number of files in one multipart request.
MEDIA_MAX_UPLOAD_BYTES=10485760
MEDIA_MAX_FILES_PER_REQUEST=4
# Images are never decoded; only header dimensions are read and bounded.
MEDIA_MAX_IMAGE_DIMENSION=20000

# --- MinIO object storage (private media) ---
# The MinIO server uses the root credentials below. The application uses a
# separate least-privilege user created by the one-shot minio-init service.
# Use real secrets only in your Git-ignored .env, never here.
MINIO_ROOT_USER=messenger-minio
MINIO_ROOT_PASSWORD=dev-only-change-me
MINIO_ACCESS_KEY=messenger-app
MINIO_SECRET_KEY=dev-only-change-me
MINIO_BUCKET=messenger-media
# Internal endpoint used by the API (Compose overrides this to minio:9000).
# It is host:port without a scheme.
MINIO_ENDPOINT=127.0.0.1:9000
# Endpoint used only when signing short-lived download URLs. It must be
# reachable by the client, so it may differ from the internal endpoint. Keep it
# in sync with MINIO_API_PORT (and use MINIO_SECURE=true for HTTPS).
MINIO_PUBLIC_ENDPOINT=127.0.0.1:9000
MINIO_SECURE=false
MINIO_REGION=us-east-1
# Optional prefix for this application/environment inside the bucket. A
# trailing slash is added automatically. Tests use a unique prefix.
MINIO_KEY_PREFIX=
# Presigned URL lifetime in seconds (30-3600).
MINIO_PRESIGNED_URL_EXPIRES_SECONDS=300
# Compose initializes the bucket with a separate service; keep this false there.
MINIO_AUTO_CREATE_BUCKET=false
MINIO_CONNECT_TIMEOUT_SECONDS=2
MINIO_READ_TIMEOUT_SECONDS=10
MINIO_MAX_RETRIES=2
# Development-only published ports, bound to loopback by Compose.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Realtime (WebSocket at /api/v1/ws) ---
# Seconds a freshly accepted socket may wait for its first {"type":"auth"} frame.
WS_AUTH_TIMEOUT_SECONDS=5
# Server-initiated application-level ping interval.
WS_HEARTBEAT_INTERVAL_SECONDS=30
# A client that sends nothing for this long is disconnected and cleaned up.
WS_IDLE_TIMEOUT_SECONDS=90
# How often an open socket re-validates its token and account state, regardless
# of the frames it sends. Logout, session revocation, token expiry and account
# deactivation therefore take effect within roughly this interval - not instantly.
WS_TOKEN_RECHECK_INTERVAL_SECONDS=30
# Concurrent sockets per account. New connections beyond this are rejected;
# existing devices are never disconnected.
WS_MAX_CONNECTIONS_PER_USER=5
# Sockets that are connected but have not authenticated yet. They are capped
# globally and per peer address; the slot is released on success, failure,
# timeout or disconnect.
WS_MAX_PENDING_CONNECTIONS=64
WS_MAX_PENDING_CONNECTIONS_PER_IP=8
# Raw text-frame ceiling in bytes (larger frames are rejected before parsing).
WS_MAX_FRAME_BYTES=65536
# Per-account realtime message budget (ping/pong frames are not counted).
WS_MESSAGE_RATE_LIMIT_ATTEMPTS=60
WS_MESSAGE_RATE_LIMIT_WINDOW_SECONDS=60
# Typing/read frames are throttled per connection. A typing "stop" is never
# throttled; a typing indicator expires client-side after WS_TYPING_EXPIRY_SECONDS.
WS_TYPING_MIN_INTERVAL_SECONDS=1
WS_TYPING_EXPIRY_SECONDS=5
WS_READ_MIN_INTERVAL_SECONDS=0.5

# --- Email delivery ---
# console  : development only — renders the message to EMAIL_OUTBOX_DIR instead
#            of sending it. Refused unless APP_ENV is local/development/test.
# smtp     : real delivery over SMTP.
# disabled : drop messages (useful for tests and for switching email off).
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@messenger.local
EMAIL_OUTBOX_DIR=var/outbox
# Lifetime of the single-use links (minutes).
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# SMTP settings (only read when EMAIL_BACKEND=smtp).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# --- Account-security rate limits (per scope, shared through Redis) ---
EMAIL_RATE_LIMIT_ATTEMPTS=3
EMAIL_RATE_LIMIT_WINDOW_SECONDS=3600
PASSWORD_RESET_RATE_LIMIT_ATTEMPTS=5
PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=3600
SEARCH_RATE_LIMIT_ATTEMPTS=60
SEARCH_RATE_LIMIT_WINDOW_SECONDS=60
CONTACT_RATE_LIMIT_ATTEMPTS=30
CONTACT_RATE_LIMIT_WINDOW_SECONDS=60
CHAT_RATE_LIMIT_ATTEMPTS=120
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
MEDIA_RATE_LIMIT_ATTEMPTS=60
MEDIA_RATE_LIMIT_WINDOW_SECONDS=60
