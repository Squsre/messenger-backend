# Copy this file to `.env` and adjust the values for your environment.
# Never commit the real `.env` file to version control.

# --- Application ---
APP_NAME=Messenger API
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0

# --- API ---
API_V1_PREFIX=/api/v1

# --- Server ---
HOST=127.0.0.1
PORT=8000

# --- CORS ---
# Comma-separated list of allowed origins, e.g. http://localhost:3000,https://app.example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Database ---
# SQLAlchemy URL. SQLite by default (relative to the project root).
# PostgreSQL later: postgresql+psycopg://user:password@localhost:5432/messenger
DATABASE_URL=sqlite:///./messenger.db
# Log every SQL statement (useful while debugging, keep false otherwise).
DB_ECHO=false

# --- Authentication / JWT ---
# REQUIRED. Secret used to sign access tokens. Generate a strong, unique value:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# The placeholder below is a throw-away for local development only and is
# refused when APP_ENV is not a local environment.
JWT_SECRET_KEY=dev-only-change-me-please-0123456789abcdefghijklmnopqrstuvwxyz
# HMAC algorithm; only HS256/HS384/HS512 are accepted.
JWT_ALGORITHM=HS256
# Access token lifetime in minutes (keep short).
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Token issuer/audience claims.
JWT_ISSUER=messenger-api
JWT_AUDIENCE=messenger-api

# --- Login rate limiting (in-process; see README) ---
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
